# Скопируйте этот файл в .env и заполните значения.
# Ключи: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Любая длинная случайная строка — ей подписываются cookie сессии.
# Сгенерировать: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
